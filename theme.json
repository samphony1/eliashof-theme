{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "960px",
			"wideSize": "1280px"
		},
		"color": {
			"palette": [
				{ "slug": "blue",   "color": "#8cc8d1", "name": "Blue"   },
				{ "slug": "green",  "color": "#c5d799", "name": "Green"  },
				{ "slug": "orange", "color": "#eec58d", "name": "Orange" },
				{ "slug": "yellow", "color": "#f8ac41", "name": "Yellow" },
				{ "slug": "brown",  "color": "#57463a", "name": "Brown"  },
				{ "slug": "dark",   "color": "#241f21", "name": "Dark"   },
				{ "slug": "cream",  "color": "#eae7dd", "name": "Cream"  },
				{ "slug": "white",  "color": "#ffffff", "name": "White"  },
				{ "slug": "black",  "color": "#000000", "name": "Black"  }
			],
			"defaultPalette": false,
			"link": true,
			"background": true,
			"text": true
		},
		"typography": {
			"customFontSize": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"fontFamily": "'Neucha', cursive",
					"name": "Neucha",
					"slug": "neucha"
				},
				{
					"fontFamily": "'Montserrat', sans-serif",
					"name": "Montserrat",
					"slug": "montserrat"
				}
			],
			"fontSizes": [
				{ "name": "Section Heading (50px)", "size": "50px",  "slug": "section-heading" },
				{ "name": "Card Heading (32px)",    "size": "32px",  "slug": "card-heading"    },
				{ "name": "Body (24px)",             "size": "24px",  "slug": "body"            },
				{ "name": "Card Body (18px)",        "size": "18px",  "slug": "card-body"       },
				{ "name": "Button (25px)",           "size": "25px",  "slug": "button"          },
				{ "name": "Small (16px)",            "size": "16px",  "slug": "small"           }
			]
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		},
		"border": {
			"radius": true,
			"style": true,
			"width": true,
			"color": true
		}
	},
	"styles": {
		"color": {
			"background": "#ffffff",
			"text": "#241f21"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--montserrat)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"fontWeight": "300",
			"lineHeight": "1.7"
		},
		"elements": {
			"button": {
				"color": {
					"background": "#f8ac41",
					"text": "#241f21"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--neucha)",
					"fontSize": "var(--wp--preset--font-size--button)"
				},
				"border": {
					"radius": "40px",
					"width": "0.7px",
					"style": "solid",
					"color": "#000000"
				},
				"spacing": {
					"padding": {
						"top": "14px",
						"bottom": "14px",
						"left": "48px",
						"right": "48px"
					}
				}
			},
			"link": {
				"color": {
					"text": "#8cc8d1"
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--neucha)",
					"fontSize": "var(--wp--preset--font-size--section-heading)",
					"letterSpacing": "2.5px",
					"lineHeight": "1.2"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--neucha)",
					"fontSize": "var(--wp--preset--font-size--section-heading)",
					"letterSpacing": "2.5px",
					"lineHeight": "1.2"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--neucha)",
					"fontSize": "var(--wp--preset--font-size--card-heading)",
					"lineHeight": "1.3"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--neucha)",
					"fontSize": "22px"
				}
			}
		}
	}
}
